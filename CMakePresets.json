{
    "version": 3,
    "configurePresets": [
        {
            "name": "code-analysis",
            "description": "Run Clang Static Analyzer",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/.build/code-analysis",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": {
                    "value": "Debug"
                },
                "CMAKE_C_COMPILER": {
                    "value": "clang-20"
                },
                "CMAKE_CXX_COMPILER": {
                    "value": "clang++-20"
                },
                "TT_UMD_BUILD_TESTS": {
                    "value": "ON"
                },
                "TT_UMD_BUILD_SIMULATION": {
                    "value": "ON"
                }
            }
        }
    ]
}
