{
    "version": 3,
    "configurePresets": [
        {
            "name": "default",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build",
            "description": "Library and tools with the CMake option defaults"
        },
        {
            "name": "examples",
            "inherits": [
                "default"
            ],
            "description": "default with examples",
            "cacheVariables": {
                "TT_UMD_BUILD_EXAMPLES": {
                    "value": "ON"
                }
            }
        },
        {
            "name": "tests",
            "inherits": [
                "default"
            ],
            "description": "Tests and tools, without simulation, Python or clang-tidy",
            "cacheVariables": {
                "TT_UMD_BUILD_TESTS": {
                    "value": "ON"
                },
                "TT_UMD_ENABLE_CLANG_TIDY": {
                    "value": "OFF"
                }
            }
        },
        {
            "name": "simulation",
            "inherits": [
                "tests"
            ],
            "description": "Tests with simulation support, without tools and Python bindings",
            "cacheVariables": {
                "TT_UMD_BUILD_SIMULATION": {
                    "value": "ON"
                },
                "TT_UMD_BUILD_TOOLS": {
                    "value": "OFF"
                }
            }
        },
        {
            "name": "simulation-tools-python",
            "inherits": [
                "tests"
            ],
            "description": "Tests and tools with simulation support and Python bindings",
            "cacheVariables": {
                "TT_UMD_BUILD_SIMULATION": {
                    "value": "ON"
                },
                "TT_UMD_BUILD_PYTHON": {
                    "value": "ON"
                }
            }
        },
        {
            "name": "release",
            "inherits": [
                "default"
            ],
            "description": "Library and Python bindings, as shipped in release packages",
            "cacheVariables": {
                "TT_UMD_BUILD_PYTHON": {
                    "value": "ON"
                },
                "TT_UMD_BUILD_PIP": {
                    "value": "OFF"
                }
            }
        },
        {
            "name": "release-no-clang-tidy",
            "inherits": [
                "release"
            ],
            "description": "Release build without clang-tidy",
            "cacheVariables": {
                "TT_UMD_ENABLE_CLANG_TIDY": {
                    "value": "OFF"
                }
            }
        },
        {
            "name": "all-no-pip",
            "inherits": [
                "default"
            ],
            "description": "All components, without the pip package and Tracy",
            "cacheVariables": {
                "TT_UMD_BUILD_ALL": {
                    "value": "ON"
                },
                "TT_UMD_BUILD_PIP": {
                    "value": "OFF"
                }
            }
        },
        {
            "name": "all-tracy",
            "inherits": [
                "default"
            ],
            "description": "all with the pip package and Tracy",
            "cacheVariables": {
                "TT_UMD_BUILD_ALL": {
                    "value": "ON"
                },
                "TT_UMD_ENABLE_TRACY": {
                    "value": "ON"
                }
            }
        },
        {
            "name": "code-analysis",
            "inherits": [
                "default"
            ],
            "description": "Run Clang Static Analyzer",
            "cacheVariables": {
                "TT_UMD_BUILD_TESTS": {
                    "value": "ON"
                },
                "TT_UMD_BUILD_SIMULATION": {
                    "value": "ON"
                },
                "CMAKE_BUILD_TYPE": {
                    "value": "Debug"
                },
                "CMAKE_C_COMPILER": {
                    "value": "clang-20"
                },
                "CMAKE_CXX_COMPILER": {
                    "value": "clang++-20"
                }
            }
        }
    ],
    "buildPresets": [
        {
            "name": "default",
            "configurePreset": "default"
        },
        {
            "name": "examples",
            "configurePreset": "examples"
        },
        {
            "name": "tests",
            "configurePreset": "tests"
        },
        {
            "name": "simulation",
            "configurePreset": "simulation"
        },
        {
            "name": "simulation-tools-python",
            "configurePreset": "simulation-tools-python"
        },
        {
            "name": "release",
            "configurePreset": "release"
        },
        {
            "name": "release-no-clang-tidy",
            "configurePreset": "release-no-clang-tidy"
        },
        {
            "name": "all-no-pip",
            "configurePreset": "all-no-pip"
        },
        {
            "name": "all-tracy",
            "configurePreset": "all-tracy"
        },
        {
            "name": "code-analysis",
            "configurePreset": "code-analysis"
        }
    ]
}
